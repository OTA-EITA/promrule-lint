{
  "name": "promrule-lint",
  "version": "0.1.0",
  "description": "Lint Prometheus alerting and recording rules for flapping-prone alerts, missing runbooks and severities, too-short rate() windows and naming mistakes. CLI + GitHub Action, SARIF",
  "license": "MIT",
  "author": "OTA-EITA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTA-EITA/promrule-lint.git"
  },
  "keywords": [
    "prometheus",
    "alerting",
    "sre",
    "lint",
    "promql",
    "sarif"
  ],
  "type": "module",
  "bin": {
    "promrule-lint": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.12"
  }
}
